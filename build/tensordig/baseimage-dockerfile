FROM ubuntu:18.04

ARG MIRROR=archive.ubuntu.com
WORKDIR /tmp

RUN sed -i "s!archive.ubuntu.com/!${MIRROR}/!g" /etc/apt/sources.list \
    && DEBIAN_FRONTEND=noninteractive apt-get update -y \
    && apt-get install -y --no-install-recommends \
    libelf1 \
    libtinfo5 \
    ca-certificates \
    build-essential \
    bison \
    build-essential \
    cmake \
    flex \
    git \
    libedit-dev \
	libllvm7 \
    llvm-7-dev \
    libclang-7-dev \
    python \
    zlib1g-dev \
    libelf-dev \
    libfl-dev \
    wget \
    && wget https://dl.google.com/go/go1.13.9.linux-amd64.tar.gz \
    && tar xf go1.13.9.linux-amd64.tar.gz \
    && rm -f go1.13.9.linux-amd64.tar.gz