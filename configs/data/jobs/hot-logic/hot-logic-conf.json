{
  "pgTables":[
    {
      "name":"association_events",
      "timeField":"updated_at",
      "dataDir":"/audit/postgresql/association_events",
      "batch":1000
    },
    {
      "name":"gc_tasks",
      "timeField":"finished_at",
      "condition": "status != 'inprogress'",
      "dataDir":"/audit/postgresql/gc_tasks",
      "batch":1000
    },
    {
      "name": "tensor_namespaces",
      "timeField": "updated_at",
      "condition": "status = 1",
      "dataDir": "/audit/posggresql/tensor_namespaces",
      "batch": 1000
    },
    {
      "name": "tensor_containers",
      "timeField": "updated_at",
      "condition": "status = 1",
      "dataDir": "/audit/posggresql/tensor_containers",
      "batch": 1000
    },
    {
      "name": "tensor_resources",
      "timeField": "updated_at",
      "condition": "status = 1",
      "dataDir": "/audit/posggresql/tensor_resources",
      "batch": 1000
    },
    {
      "name": "tensor_network_flows",
      "timeField": "updated_at",
      "condition": "status in (0, 1)",
      "dataDir": "/audit/posggresql/tensor_network_flows",
      "batch": 1000
    },
    {
      "name": "tensor_microseg_resources",
      "timeField": "updated_at",
      "condition": "status = 1",
      "dataDir": "/audit/posggresql/tensor_microseg_resources",
      "batch": 1000
    },
    {
      "name": "reject_record",
      "timeField": "reject_at",
      "condition": "",
      "dataDir": "/audit/posggresql/reject_record",
      "batch": 1000
    }
  ],
  "mongoUnifiedConf": {
    "batch": 50,
    "baseDir": "/audit/mongo",
    "timeField": "historicised_timestamp",
    "excludedCollections": ["cluster", "podServiceRelation", "podOwnerRefRelation"]
  }
}
