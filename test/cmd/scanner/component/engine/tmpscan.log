      {
        "VulnerabilityID": "CVE-2021-22922",
        "PkgName": "libcurl4",
        "InstalledVersion": "7.64.0-4+deb10u2",
        "Layer": {
          "Digest": "sha256:83acae5e2daa7de1558d14970fed734716c0067ca4dee30ece2e9f9a99571a2c",
